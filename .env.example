MONGODB_URI=mongodb://127.0.0.1:27017/tutor
JWT_SECRET=change-this-to-a-long-random-string

# Allowed frontend origin for CORS (production: https://your-app.vercel.app)
FRONTEND_ORIGIN=http://localhost:5173

# Gmail SMTP OTP delivery — use a Google App Password, not your normal password
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
MAIL_FROM=Tudoor <your-email@gmail.com>
